        "import yfinance as yf\n",
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. Define the assets you want to track\n",
        "# Brent Oil, US 10Y Yield, Nifty 50 (India), and Apple (US Tech), and Google\n",
        "tickers = [\"BZ=F\", \"^TNX\", \"^NSEI\", \"AAPL\", \"TSM\"]\n",
        "\n",
        "# 2. Download the data (last 2 years)\n",
        "df = yf.download(tickers, period=\"2y\")['Close']\n",
        "\n",
        "# 3. Convert prices to daily percentage changes (Returns)\n",
        "# This is crucial! Correlations on raw prices are often misleading.\n",
        "returns = df.pct_change().dropna()\n",
        "\n",
        "# 4. Create the correlation matrix\n",
        "matrix = returns.corr()\n",
        "\n",
        "# 5. Visualize it with a Heatmap\n",
        "plt.figure(figsize=(10, 8))\n",
        "sns.heatmap(matrix, annot=True, cmap='magma', center=0)\n",
        "plt.title('Asset Correlation Matrix: Macro vs. Equity')\n",
        "plt.show()"
      ],
